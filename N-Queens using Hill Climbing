N-Queens using Hill Climbing
N = 4
board = [1, 3, 0, 2]
def attacks(b):
    c = 0
    for i in range(N):
        for j in range(i + 1, N):
            if b[i] == b[j] or abs(b[i] - b[j]) == abs(i - j):
                c += 1
    return c
if attacks(board) == 0:
    print("Solution Found")
    print(board)
else:
    print("Not Solution")
